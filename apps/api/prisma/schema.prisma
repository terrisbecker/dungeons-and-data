generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Fixed 5e sets. Free text (race, className, item/condition names) stays
// elsewhere to keep homebrew open.
enum Ability {
  STR
  DEX
  CON
  INT
  WIS
  CHA
}

enum Alignment {
  LG // Lawful Good
  NG // Neutral Good
  CG // Chaotic Good
  LN // Lawful Neutral
  TN // True Neutral
  CN // Chaotic Neutral
  LE // Lawful Evil
  NE // Neutral Evil
  CE // Chaotic Evil
}

enum Skill {
  ACROBATICS // DEX
  ANIMAL_HANDLING // WIS
  ARCANA // INT
  ATHLETICS // STR
  DECEPTION // CHA
  HISTORY // INT
  INSIGHT // WIS
  INTIMIDATION // CHA
  INVESTIGATION // INT
  MEDICINE // WIS
  NATURE // INT
  PERCEPTION // WIS
  PERFORMANCE // CHA
  PERSUASION // CHA
  RELIGION // INT
  SLEIGHT_OF_HAND // DEX
  STEALTH // DEX
  SURVIVAL // WIS
}

enum SkillProficiency {
  PROFICIENT
  EXPERTISE
  HALF // Jack of All Trades / Remarkable Athlete
}

enum SpellSchool {
  ABJURATION
  CONJURATION
  DIVINATION
  ENCHANTMENT
  EVOCATION
  ILLUSION
  NECROMANCY
  TRANSMUTATION
}

enum FeatureSource {
  RACE
  CLASS
  SUBCLASS
  BACKGROUND
  FEAT
}

enum RestType {
  SHORT
  LONG
  OTHER // e.g. dawn, per-turn, recharge X-Y
}

enum CreatureSize {
  TINY
  SMALL
  MEDIUM
  LARGE
  HUGE
  GARGANTUAN
}

// A Player's role WITHIN a campaign; lives on the membership, not on Player,
// since one person can DM one game and play in another.
enum CampaignRole {
  DUNGEON_MASTER
  PLAYER
}

// A Player's GLOBAL role. ADMIN can CRUD everything; USER's authority comes
// from campaign membership (DM) and character ownership (player).
enum SystemRole {
  USER
  ADMIN
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  ON_HIATUS
  COMPLETED
  ARCHIVED
}

// Broad item bucket; weapon/armor sub-details live in the *Category fields
// below. Closed set — use OTHER + tags for oddities.
enum ItemType {
  ADVENTURING_GEAR
  WEAPON
  ARMOR // includes shields (see ArmorCategory.SHIELD)
  AMMUNITION
  POTION
  SCROLL
  WAND
  ROD
  STAFF
  RING
  WONDROUS_ITEM
  TOOL
  FOOD_AND_DRINK
  TRADE_GOOD
  CONTAINER
  MOUNT_OR_VEHICLE
  TREASURE
  OTHER
}

// 5e magic-item rarity; mundane gear is COMMON.
enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  VERY_RARE
  LEGENDARY
  ARTIFACT
}

enum WeaponCategory {
  SIMPLE
  MARTIAL
}

enum WeaponProperty {
  AMMUNITION
  FINESSE
  HEAVY
  LIGHT
  LOADING
  RANGE
  REACH
  SPECIAL
  THROWN
  TWO_HANDED
  VERSATILE
}

enum ArmorCategory {
  LIGHT
  MEDIUM
  HEAVY
  SHIELD
}

enum DamageType {
  ACID
  BLUDGEONING
  COLD
  FIRE
  FORCE
  LIGHTNING
  NECROTIC
  PIERCING
  POISON
  PSYCHIC
  RADIANT
  SLASHING
  THUNDER
}

// NPCs and monsters share an identical stat block, so Creature is one table
// discriminated by this kind.
enum CreatureKind {
  NPC
  MONSTER
}

// 5e creature types. Homebrew/parenthetical subtypes ("goblinoid",
// "shapechanger") stay free-text on Creature.typeTags.
enum CreatureType {
  ABERRATION
  BEAST
  CELESTIAL
  CONSTRUCT
  DRAGON
  ELEMENTAL
  FEY
  FIEND
  GIANT
  HUMANOID
  MONSTROSITY
  OOZE
  PLANT
  UNDEAD
}

// Drives one polymorphic StatBlockEntry table (traits, actions,
// legendary/lair, etc.) instead of a table per section.
enum StatBlockEntryCategory {
  TRAIT
  ACTION
  BONUS_ACTION
  REACTION
  LEGENDARY_ACTION
  MYTHIC_ACTION
  LAIR_ACTION
  REGIONAL_EFFECT
}

enum DamageModifierKind {
  VULNERABILITY
  RESISTANCE
  IMMUNITY
}

// A real person / user account (distinct from PlayerCharacter, the in-world
// hero). Doubles as the auth account.
model Player {
  id          String  @id @default(uuid()) @db.Uuid
  username    String  @unique
  displayName String?

  // scrypt "salt:hash" (src/auth/password.ts); nullable for a login-less
  // placeholder Player; never selected outside login.
  passwordHash String?
  systemRole   SystemRole @default(USER)

  memberships CampaignMembership[]
  characters  PlayerCharacter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One running game — the scope for campaign-owned PlayerCharacter, Location,
// and Creature rows. Shared catalogs (Item/Spell/Feat/Feature) are NOT scoped.
// The DM is the membership whose role is DUNGEON_MASTER, not a column
// (supports co-DMs). "≥1 DM per campaign" is a service-layer invariant.
model Campaign {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  description String?
  status      CampaignStatus @default(PLANNING)

  memberships CampaignMembership[]
  characters  PlayerCharacter[]
  locations   Location[]
  creatures   Creature[] // campaign-specific; shared ones have null campaignId

  // Nullable 1:1 — no row until settings are first touched.
  economySettings CampaignEconomySettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 1:1 satellite of Campaign. Toggles the supply/demand economy engine and
// sets the global price floor/ceiling clamp (one +/-% pair for every type).
model CampaignEconomySettings {
  campaignId String   @id @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  economyEnabled Boolean @default(false)
  floorPercent   Int     @default(50) // price can't drop more than this % below base
  ceilingPercent Int     @default(50) // price can't rise more than this % above base

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A Player's seat at a Campaign, carrying their role in that game.
model CampaignMembership {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  playerId   String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  role CampaignRole @default(PLAYER)

  joinedAt DateTime @default(now())

  @@unique([campaignId, playerId])
  @@index([playerId])
}

// Self-referencing hierarchy (realm → region → town → building → cottage).
// Occupants attach via explicit join models.
model Location {
  id           String  @id @default(uuid()) @db.Uuid
  locationName String
  description  String?
  type         String // free text: region, country, city, town, cottage, ...
  // type == "building" (trimmed/lowercased) gets a building inventory in the
  // frontend — see isBuildingType(). No dedicated flag.

  // Nullable so a shared/template world can exist unscoped; campaign-owned
  // rows cascade-delete with the campaign.
  campaignId String?   @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  parentId String?    @db.Uuid
  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children Location[] @relation("LocationHierarchy")

  // Economy engine: a location's contribution to an item type's price
  // modifier is (demandLevel - supplyLevel) / demandSlope, stacking up the
  // parent chain (inventory-items.derived.ts). These are the fallback; when
  // useItemTypeEconomy is true, LocationItemTypeEconomy rows take over
  // instead (a type with no row there is neutral 0/0 — the modes are
  // mutually exclusive per location).
  supplyLevel        Int     @default(0)
  demandLevel        Int     @default(0)
  useItemTypeEconomy Boolean @default(false)

  creaturePlacements CreaturePlacement[]
  inventory          InventoryItem[]
  itemTypeEconomy    LocationItemTypeEconomy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([campaignId])
}

// The hub. Ability scores are six fixed integer columns storing FINAL values
// (base + racial ASI + level ASIs/feats); skills live in CharacterSkill so
// proficiency vs. expertise can be expressed.
model PlayerCharacter {
  id            String       @id @default(uuid()) @db.Uuid
  characterName String
  race          String // free text (supports homebrew)
  subrace       String? // e.g. "High Elf"
  alignment     Alignment?
  size          CreatureSize @default(MEDIUM)

  // Class/level via CharacterClass; total level (and prof bonus) is derived
  // in the service layer, not stored.

  experiencePoints Int     @default(0)
  inspiration      Boolean @default(false)

  strength     Int @db.SmallInt
  dexterity    Int @db.SmallInt
  constitution Int @db.SmallInt
  intelligence Int @db.SmallInt
  wisdom       Int @db.SmallInt
  charisma     Int @db.SmallInt

  strengthSaveProf     Boolean @default(false)
  dexteritySaveProf    Boolean @default(false)
  constitutionSaveProf Boolean @default(false)
  intelligenceSaveProf Boolean @default(false)
  wisdomSaveProf       Boolean @default(false)
  charismaSaveProf     Boolean @default(false)

  // Combat. proficiencyBonus/initiative/passive scores/spell DC & attack
  // bonus/armorClass are derived, not stored. armorClass comes from equipped
  // armor/shield InventoryItems + Dex; baseArmorClass is the nullable
  // fallback (null = 10 + Dex unarmored, or a hand-set AC for cases the
  // equipment formula can't express).
  maxHitPoints        Int
  currentHitPoints    Int
  temporaryHitPoints  Int  @default(0)
  hitPointMaxModifier Int  @default(0) // effects that raise/lower max HP
  baseArmorClass      Int?
  deathSaveSuccesses  Int  @default(0)
  deathSaveFailures   Int  @default(0)

  // Movement (feet). Non-walking speeds null = the race lacks it.
  speed      Int  @default(30)
  flySpeed   Int?
  swimSpeed  Int?
  climbSpeed Int?

  darkvision Int? // range in feet; null = none

  // Plain FK (no relation) to keep the write path simple.
  concentratingOnSpellId String? @db.Uuid

  copper   Int @default(0)
  silver   Int @default(0)
  electrum Int @default(0)
  gold     Int @default(0)
  platinum Int @default(0)

  description String?
  background  String? // free text; grants proficiencies/features via Feature rows

  traits String? // personality traits
  ideals String?
  bonds  String?
  flaws  String?

  // Both nullable: a character can be drafted before being assigned to a
  // player or campaign. SetNull detaches rather than destroys.
  playerId   String?   @db.Uuid
  player     Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  campaignId String?   @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  skills        CharacterSkill[]
  inventory     InventoryItem[]
  classes       CharacterClass[]
  proficiencies Proficiency[]
  spells        CharacterSpell[]
  feats         CharacterFeat[]
  features      CharacterFeature[]
  conditions    CharacterCondition[]
  resources     CharacterResource[]
  spellSlots    SpellSlot[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  @@index([playerId])
  @@index([campaignId])
}

// A class a character has levels in. Multiple rows = multiclassing.
model CharacterClass {
  id          String          @id @default(uuid()) @db.Uuid
  characterId String          @db.Uuid
  character   PlayerCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  className String // "Wizard"
  subclass  String? // "Evocation"
  level     Int     @default(1)

  // Hit dice are per-class (die size fixed); hitDiceUsed tracks spend across
  // short rests, max = level.
  hitDieSize  Int // 6, 8, 10, 12 (a d8 -> 8)
  hitDiceUsed Int @default(0)

  // Null for non-casters; drives spell save DC / attack bonus.
  spellcastingAbility Ability?

  @@unique([characterId, className])
}

// Per-level spell slots. Warlock pact magic is a separate track (isPact).
model SpellSlot {
  id          String          @id @default(uuid()) @db.Uuid
  characterId String          @db.Uuid
  character   PlayerCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  level  Int // 1–9
  max    Int
  used   Int     @default(0)
  isPact Boolean @default(false)

  @@unique([characterId, level, isPact])
}

// Limited-use pools: Rage, Ki, Channel Divinity, Bardic Inspiration, Sorcery
// Points, Superiority Dice, Lay on Hands, etc.
model CharacterResource {
  id          String          @id @default(uuid()) @db.Uuid
  characterId String          @db.Uuid
  character   PlayerCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  name       String // "Rage", "Ki Points", "Channel Divinity"
  current    Int
  max        Int
  rechargeOn RestType @default(LONG)

  @@unique([characterId, name])
}

// Weapon / armor / tool / language / saving-throw proficiencies.
model Proficiency {
  id          String          @id @default(uuid()) @db.Uuid
  characterId String          @db.Uuid
  character   PlayerCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  type String // "weapon" | "armor" | "tool" | "language" | "save"
  name String // "Longsword", "Thieves' Tools", "Elvish", ...

  @@unique([characterId, type, name])
}

// A single skill proficiency held by a character. Absence = not proficient.
model CharacterSkill {
  id          String          @id @default(uuid()) @db.Uuid
  characterId String          @db.Uuid
  character   PlayerCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  skill       Skill
  proficiency SkillProficiency @default(PROFICIENT)

  @@unique([characterId, skill])
}

// Catalog definition of an item — created ONCE and shared. Ownership and
// per-instance state live in InventoryItem, so one "Shortsword" row can be
// assigned to any number of characters/creatures/locations.
model Item {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?

  type    ItemType   @default(ADVENTURING_GEAR)
  rarity  ItemRarity @default(COMMON)
  isMagic Boolean    @default(false)
  tags    String[] // free-text labels: "silvered", "quest", ...

  // Whether a given owner is actually attuned is per-instance
  // (InventoryItem.attuned); 5e caps attunement at 3 — enforced in the
  // service layer.
  requiresAttunement Boolean @default(false)

  weight     Float? // pounds; null = negligible / none
  stackable  Boolean @default(false) // arrows/rations stack; plate armor doesn't
  consumable Boolean @default(false) // potions, scrolls, rations

  // Reference value only, in COPPER (atomic 5e unit, integer, no float
  // drift; 1 gp = 100 cp). null = unpriced/priceless/quest item. The economy
  // layer (shop modifiers, supply/demand, per-region pricing) sits on top.
  baseValueCp Int?

  // Type-specific stats live in 1:1 satellite tables (WeaponStats/
  // ArmorStats), not as nullable columns here. "type ⟺ stat block" pairing
  // is a service-layer invariant.
  weapon WeaponStats?
  armor  ArmorStats?

  inventory InventoryItem[]

  @@index([type])
  @@index([rarity])
}

// Weapon-only stats. Exactly one row per WEAPON-typed Item.
model WeaponStats {
  itemId String @id @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  weaponCategory   WeaponCategory
  damageDice       String // "1d8" (free text keeps homebrew open)
  damageType       DamageType
  versatileDamage  String? // two-handed damage for versatile weapons, e.g. "1d10"
  weaponProperties WeaponProperty[]
  rangeNormal      Int? // feet (thrown/ranged)
  rangeLong        Int? // feet
}

// Armor-only stats (includes shields via ArmorCategory.SHIELD). Exactly one
// row per ARMOR-typed Item.
model ArmorStats {
  itemId String @id @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  armorCategory       ArmorCategory
  baseArmorClass      Int // for a shield, the bonus (e.g. 2); interpret by category in the service layer
  addDexToArmorClass  Boolean       @default(false) // light/medium armor add Dex mod
  maxDexBonus         Int? // medium armor caps at +2; null = uncapped
  strengthRequirement Int? // heavy armor STR minimum
  stealthDisadvantage Boolean       @default(false)
}

// Per-ItemType economy curve parameter — the equilibrium-displacement
// pricing model's one configurable constant (demand slope M) per type; see
// inventory-items.derived.ts. Backend/seed-managed, no admin UI.
model ItemTypeEconomyConfig {
  itemType    ItemType @id
  demandSlope Decimal  @default(1.0) @db.Decimal(10, 4)

  updatedAt DateTime @updatedAt
}

// A location's per-ItemType override of its global supply/demand sliders.
// Only consulted when the location's useItemTypeEconomy is true; a type with
// no row here is neutral (0/0), not a fallback to the global sliders.
model LocationItemTypeEconomy {
  locationId String   @db.Uuid
  itemType   ItemType
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  supplyLevel Int @default(0)
  demandLevel Int @default(0)

  @@id([locationId, itemType])
}

// One catalog Item assigned to one owner, with per-instance state. Exactly
// one owner FK should be set — enforced in the service layer + a CHECK
// constraint in the migration.
model InventoryItem {
  id     String @id @default(uuid()) @db.Uuid
  itemId String @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  // Polymorphic owner. A location owner = stock in a building's inventory
  // (docs/economy-layer.md).
  characterId String?          @db.Uuid
  character   PlayerCharacter? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  creatureId  String?          @db.Uuid
  creature    Creature?        @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  locationId  String?          @db.Uuid
  location    Location?        @relation(fields: [locationId], references: [id], onDelete: Cascade)

  quantity Int     @default(1)
  equipped Boolean @default(false)
  attuned  Boolean @default(false)

  @@index([itemId])
  @@index([characterId])
  @@index([creatureId])
  @@index([locationId])
}

// The reusable NPC / Monster profile. NPCs and monsters share an identical
// stat block, so they're one table discriminated by `kind`; NPC-only and
// Monster-only fields sit alongside as nullable columns. Derived values
// (proficiency bonus from CR, save/skill bonuses, passive Perception, spell
// math) are computed in the service layer, never stored.
model Creature {
  id   String       @id @default(uuid()) @db.Uuid
  kind CreatureKind // NPC | MONSTER — discriminator

  name        String
  description String?

  size          CreatureSize  @default(MEDIUM)
  creatureType  CreatureType? // aberration, beast, ... (5e type)
  typeTags      String[] // free-text subtypes: "goblinoid", "shapechanger"
  alignment     Alignment?
  alignmentNote String? // "unaligned", "any evil alignment" — beyond the enum

  // armorClass is derived (equipped armor/shield + Dex, 5e rules), not
  // stored. baseArmorClass is the nullable fallback: null = 10 + Dex
  // unarmored, or a hand-set number (natural armor, feature-style AC).
  baseArmorClass Int?
  armorClassNote String? // "natural armor", "18 with mage armor"
  hitPoints      Int // average HP
  hitDice        String? // "18d10 + 36"

  // Movement (feet). null = the creature lacks that mode.
  speed       Int     @default(30)
  flySpeed    Int?
  swimSpeed   Int?
  climbSpeed  Int?
  burrowSpeed Int?
  hover       Boolean @default(false)

  strength     Int @db.SmallInt
  dexterity    Int @db.SmallInt
  constitution Int @db.SmallInt
  intelligence Int @db.SmallInt
  wisdom       Int @db.SmallInt
  charisma     Int @db.SmallInt

  strengthSaveProf     Boolean @default(false)
  dexteritySaveProf    Boolean @default(false)
  constitutionSaveProf Boolean @default(false)
  intelligenceSaveProf Boolean @default(false)
  wisdomSaveProf       Boolean @default(false)
  charismaSaveProf     Boolean @default(false)

  // Range in feet; null = absent. Passive Perception is derived.
  darkvision  Int?
  blindsight  Int?
  blindBeyond Boolean @default(false) // "blind beyond this radius"
  tremorsense Int?
  truesight   Int?

  languages           String? // free text: "Common, Draconic", "understands Abyssal", "—"
  conditionImmunities String[] // free-text to match CharacterCondition.name

  // Exact for 1/8, 1/4, 1/2 and integers to 30; XP as the block prints it.
  // Proficiency bonus is derived from CR, not stored.
  challengeRating  Decimal? @db.Decimal(5, 3)
  experiencePoints Int?

  legendaryActionsPerRound Int? // usually 3
  hasLair                  Boolean @default(false)

  environment String[] // habitats: "Forest", "Underdark"
  source      String? // "Monster Manual", homebrew doc, ...

  occupation String? // "Blacksmith", "Guard Captain"
  faction    String?
  race       String?

  // Null = shared catalog creature (e.g. Monster Manual goblin), reusable
  // across every game; non-null = campaign-specific, cascades with it.
  campaignId String?   @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  entries         StatBlockEntry[]
  skills          CreatureSkill[]
  damageModifiers CreatureDamageModifier[]
  inventory       InventoryItem[]
  placements      CreaturePlacement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([creatureType])
  @@index([campaignId])
}

// A single stat-block section (trait / action / legendary action / ...).
// One polymorphic table keyed by `category` instead of a table per section.
model StatBlockEntry {
  id         String   @id @default(uuid()) @db.Uuid
  creatureId String   @db.Uuid
  creature   Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  category    StatBlockEntryCategory
  name        String // "Multiattack", "Bite", "Legendary Resistance"
  description String // free-text MM prose (to-hit, damage, effects)

  sortOrder     Int  @default(0) // preserve MM ordering within a category
  legendaryCost Int? // "Costs 2 Actions" for legendary actions

  @@index([creatureId])
}

// Mirrors CharacterSkill; the +N bonus is derived (ability mod + prof,
// doubled for EXPERTISE).
model CreatureSkill {
  id         String   @id @default(uuid()) @db.Uuid
  creatureId String   @db.Uuid
  creature   Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  skill       Skill
  proficiency SkillProficiency @default(PROFICIENT)

  @@unique([creatureId, skill])
}

// Damage vulnerability / resistance / immunity. `note` carries the qualifier
// ("from nonmagical attacks not made with silvered weapons"); `damageType`
// may be null for a purely descriptive line.
model CreatureDamageModifier {
  id         String   @id @default(uuid()) @db.Uuid
  creatureId String   @db.Uuid
  creature   Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  kind       DamageModifierKind
  damageType DamageType?
  note       String?

  @@index([creatureId])
}

// Explicit join for the Creature <-> Location many-to-many, so each
// assignment can carry its own fields.
model CreaturePlacement {
  creatureId String @db.Uuid
  locationId String @db.Uuid

  creature Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  quantity Int     @default(1) // how many appear at this location
  notes    String? // per-location detail, e.g. "runs the north-gate armory"

  @@id([creatureId, locationId])
}

// Spell/Feat/Feature are shared catalog rows; the join models attach them to
// a character with the per-character state D&D tracks (prepared/known, etc.).
model Spell {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  level       Int // 0 = cantrip
  school      SpellSchool?
  description String?

  castingTime String? // "1 action", "1 bonus action", "1 minute"
  range       String? // "60 feet", "Self", "Touch"
  duration    String? // "Instantaneous", "Concentration, up to 1 minute"
  higherLevel String? // "At Higher Levels" scaling text

  verbal            Boolean @default(false)
  somatic           Boolean @default(false)
  material          Boolean @default(false)
  materialComponent String? // "a tiny ball of bat guano and sulfur"

  concentration Boolean @default(false)
  ritual        Boolean @default(false)

  // Structured combat hooks for the future combat layer. Null when the spell
  // forces no save / deals no typed damage; isAttack flags spell attacks.
  savingThrow Ability?
  damageType  DamageType?
  isAttack    Boolean     @default(false)

  characters CharacterSpell[]
}

model CharacterSpell {
  characterId String          @db.Uuid
  spellId     String          @db.Uuid
  character   PlayerCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // Restrict: blocks deleting a Spell still referenced by a character.
  spell       Spell           @relation(fields: [spellId], references: [id], onDelete: Restrict)

  known          Boolean @default(true)
  prepared       Boolean @default(false)
  // Domain/oath/subclass spells always prepared, not counted against the limit.
  alwaysPrepared Boolean @default(false)
  sourceClass    String? // which class granted it (multiclass casters)

  @@id([characterId, spellId])
}

model Feat {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  prerequisite String? // "Strength 13 or higher", "Ability to cast a spell"
  repeatable   Boolean @default(false)

  grantsAbilityScoreIncrease Boolean @default(false) // half-feats grant +1 ability score

  characters CharacterFeat[]
}

model CharacterFeat {
  characterId String          @db.Uuid
  featId      String          @db.Uuid
  character   PlayerCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // Restrict: blocks deleting a Feat still referenced by a character.
  feat        Feat            @relation(fields: [featId], references: [id], onDelete: Restrict)

  @@id([characterId, featId])
}

// Generalized features/traits: class features, subclass features, racial
// traits, background features. Feats fit here too (source = FEAT) but keep
// their own catalog above.
model Feature {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  source      FeatureSource

  level   Int? // class level gained at; null for racial/background
  subtype String? // free-text origin detail: "Wizard", "School of Evocation", "Elf"

  characters CharacterFeature[]

  @@unique([name, source])
}

model CharacterFeature {
  characterId String          @db.Uuid
  featureId   String          @db.Uuid
  character   PlayerCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // Restrict: blocks deleting a Feature still referenced by a character.
  feature     Feature         @relation(fields: [featureId], references: [id], onDelete: Restrict)

  notes String? // per-character detail, e.g. a chosen option

  @@id([characterId, featureId])
}

// Active status effects (poisoned, prone, ...). Free-text name keeps homebrew open.
model CharacterCondition {
  id          String          @id @default(uuid()) @db.Uuid
  characterId String          @db.Uuid
  character   PlayerCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  name  String // "poisoned", "prone", "exhaustion"
  level Int? // for stacking conditions like exhaustion
  notes String?

  @@unique([characterId, name])
}
